PASSWORD=your_password
VIEW_ONLY_PASSWORD=your_view_only_password
BOOKING_URL=https://eubbc-digital.upb.edu/booking/
VNC_SERVER_IP_ADDRESS=your_ip_address
VNC_SERVER_PORT=your_port
# In the referer variable you need to put your complete website url, including the port, e.g http://localhost:3000
REFERER=your_complete_website_url
# List of cameras in JSON format
# Each camera includes its RTSP URL and the WebSocket port where its stream will be broadcast
CAMERAS=[{"url":"camera1_rtsp_url","wsPort":camera1_ws_port},{"url":"camera2_rtsp_url","wsPort":camera2_ws_port},{"url":"camera3_rtsp_url","wsPort":camera3_ws_port},{"url":"camera4_rtsp_url","wsPort":camera4_ws_port}]